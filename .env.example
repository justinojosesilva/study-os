# Owner/superuser connection — migrations, scripts, RLS setup (bypasses RLS).
DATABASE_URL="postgresql://studyos:studyos@localhost:5435/studyos"
# Restricted app-runtime connection — RLS is enforced against this role.
# Run `npm run db:rls` to create the role, then set the matching password here.
APP_DATABASE_URL="postgresql://studyos_app:studyos_app@localhost:5435/studyos"

# --- Auth.js (GitHub OAuth) ---
# Generate with: npx auth secret  (or: openssl rand -base64 33)
AUTH_SECRET=""
# Create a GitHub OAuth App: https://github.com/settings/developers
# Homepage URL: http://localhost:3010
# Authorization callback URL: http://localhost:3010/api/auth/callback/github
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""

# Quem pode entrar, por e-mail, separados por vírgula. FALHA FECHADA:
# variável ausente ou vazia = ninguém entra. Sem isso o app aceitaria qualquer
# conta do GitHub. A cota de IA limita o estrago, mas não o elimina: ela é POR
# DONO, então cada conta nova ganha o próprio teto — na sua fatura da Anthropic.
AUTH_ALLOWED_EMAILS=voce@exemplo.com

# Dev-only bypass: when "true" (never in production), the app skips auth and
# uses DEV_OWNER_ID. Set "false" to require real GitHub login.
AUTH_DEV_BYPASS="false"

# Owner id used by the dev bypass and by scripts (seed/backfill).
# Run `npm run db:seed` — it prints the id to paste here.
DEV_OWNER_ID=""

# --- AI (Claude) gap-analysis (phase 3) ---
# Get a key at https://console.anthropic.com. Empty → mock output is used.
ANTHROPIC_API_KEY=""
# "true" forces the canned mock analysis; "false" hits the real model.
# O mock não passa pela cota: não gasta e não é registrado.
AI_MOCK="false"

# --- Cota de IA ---
# Teto de gasto por dono, em MILIONÉSIMOS DE DÓLAR (US$ 1 = 1000000). Inteiro
# de propósito: em centavos quase toda chamada arredondaria para zero.
# As janelas são MÓVEIS — 24h e 30 dias para trás, não viradas de calendário.
# Omitidas, valem os padrões abaixo. O teto é conferido ANTES da chamada, então
# quem está logo abaixo do limite ainda consegue uma última chamada cara.
AI_DAILY_LIMIT_MICROS="5000000"
AI_MONTHLY_LIMIT_MICROS="30000000"
